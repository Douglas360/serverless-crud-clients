{
  "compilerOptions": {
    "target": "ES2022",
    "module": "CommonJS",
    "outDir": "dist", // Diretório para saída dos arquivos compilados
    "rootDir": "src", // Define o diretório raiz dos arquivos TypeScript
    "strict": true,
    "esModuleInterop": true
  },
  "include": ["src"],
  "exclude": ["node_modules", "dist"]
}
